# ---------------------------------------------------------------------------
# Root-level .env.example — copy to .env and fill in real values.
# Used by docker-compose.yml.
# ---------------------------------------------------------------------------

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=dharohar
POSTGRES_PASSWORD=dharohar
POSTGRES_DB=dharohar
POSTGRES_PORT=5432

# --- Redis ------------------------------------------------------------------
REDIS_PORT=6379

# --- Backend ----------------------------------------------------------------
BACKEND_PORT=8000

# REQUIRED in production — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-in-production-to-a-secure-random-32-byte-string

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173

# File upload limits (bytes — default 50 MB)
MAX_UPLOAD_SIZE_BYTES=52428800

# Set to "development" locally, "production" in deployed environments
ENVIRONMENT=development
